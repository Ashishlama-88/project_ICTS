weather_cols <- c(
"is_clear",
"is_rainy",
"is_snowy",
"is_foggy",
"is_stormy"
)
weather_units <- df_clean %>%
pivot_longer(cols = all_of(weather_cols),
names_to = "condition",
values_to = "present") %>%
filter(present == 1) %>%
group_by(condition) %>%
summarise(units = sum(units, na.rm = TRUE))
ggplot(weather_units, aes(x = condition, y = units)) +
geom_col(fill = "steelblue") +
scale_y_continuous(labels = scales::comma) +
labs(
title = "Units Sold by Weather Condition",
x = "Weather Condition",
y = "Total Units Sold"
) +
theme_minimal()
