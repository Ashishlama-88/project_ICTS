# R² on training data (SS-based, comparable to lm's train_r2)
train_preds <- predict(dt_model, newdata = train_data)
train_r2 <- 1 - sum((train_data$units - train_preds)^2) /
sum((train_data$units - mean(train_data$units))^2)
val_preds  <- predict(dt_model, newdata = val_data)
val_rmse   <- sqrt(mean((val_preds - val_data$units)^2))
test_preds <- predict(dt_model_5, newdata = test_data)
test_rmse  <- sqrt(mean((test_preds - test_data$units)^2))
test_mae   <- mean(abs(test_preds - test_data$units))
dt_performance_by_item[[as.character(5)]] <- data.frame(
item_nbr  = 5,
train_r2  = train_r2,
val_rmse  = val_rmse,
test_rmse = test_rmse,
test_mae  = test_mae,
tree_size = nrow(dt_model_5$frame),
n_train = nrow(train_data), n_val = nrow(val_data), n_test = nrow(test_data)
)
dt_performance_summary <- bind_rows(dt_performance_by_item)
dt_performance_summary        # print in its own chunk
dt_importance_summary <- bind_rows(dt_importance_by_item)
dt_importance_summary         # print in its own chunk
